CREATE OR REPLACE VIEW nuget_dapr_client_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM nuget_dapr_client
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM nuget_dapr_client
)
ORDER BY package_name;

---

CREATE OR REPLACE VIEW npm_dapr_dapr_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM npm_dapr_dapr
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM npm_dapr_dapr
)
ORDER BY package_name;

---

CREATE OR REPLACE VIEW python_dapr_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM python_dapr
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM python_dapr
)
ORDER BY package_name;

---

-- One view per PyPI package. pypistats reports downloads over a window rather
-- than a cumulative total, so the weekly rate comes straight from the row and
-- needs no comparison with the previous collection.

CREATE OR REPLACE VIEW python_dapr_view AS

SELECT
    collection_date,
    package_version,
    download_count,
    collected_over_number_of_days,
    CEIL(download_count::numeric / collected_over_number_of_days::numeric * 7::numeric) AS weekly_download_count
FROM
    python_dapr
WHERE
    package_name = 'dapr'
ORDER BY
    collection_date;

---

