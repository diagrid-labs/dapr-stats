FROM
    (SELECT
        collection_date::date AS collection_date,
        package_version,
        download_count,
        ROUND(EXTRACT(EPOCH FROM collection_date - LAG(collection_date, 1, collection_date - INTERVAL '15 days') OVER (PARTITION BY package_version ORDER BY collection_date)) / 86400.0, 3) AS days_diff
    FROM
