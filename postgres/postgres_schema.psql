-- One-off table of 2024 growth projections, filled in by hand rather than by a
-- collector. Kept for the historical comparison in the Grafana dashboard.
CREATE TABLE projections_2024 (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    day INT NOT NULL,
    discord_member_count INT NOT NULL,
