CREATE VIEW java_dapr_sdk_view AS

SELECT 
    collection_date::date,
    package_version,
    ROUND(download_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_downloads
FROM 
    java_dapr_sdk
ORDER BY 
    collection_date,
    package_version

---

CREATE VIEW weekly_github_counts_dapr AS
SELECT 
    repo_name,
    collection_date,
    ROUND(issue_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_issue_count,
    ROUND(comment_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_comment_count,
    ROUND(commit_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_commit_count,
    ROUND(pullrequest_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_pullrequest_count,
    ROUND(distinct_user_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_distinct_user_count
FROM 
    github_dapr

---

CREATE OR REPLACE VIEW dockerhub_images_view AS

SELECT
    namespace,
    image_name,
    collection_date,
    days_diff,
    pull_count_diff,
    ROUND(pull_count_diff::numeric / NULLIF(days_diff, 0) * 7) AS avg_weekly_diff
FROM
    (SELECT
        namespace,
        image_name,
        collection_date,
        ROUND(EXTRACT(EPOCH FROM collection_date - LAG(collection_date) OVER w) / 86400.0, 3) AS days_diff,
        pull_count - LAG(pull_count) OVER w AS pull_count_diff
    FROM
        dockerhub_images
    WINDOW w AS (PARTITION BY namespace, image_name ORDER BY collection_date)
    ) sub
ORDER BY
    collection_date;

---

CREATE OR REPLACE VIEW diagrid_dashboard_view AS

SELECT
    collection_date,
    days_diff,
    download_count_diff,
    ROUND(download_count_diff::numeric / NULLIF(days_diff, 0) * 7) AS avg_weekly_diff
FROM
    (SELECT
        collection_date,
        ROUND(EXTRACT(EPOCH FROM collection_date - LAG(collection_date) OVER w) / 86400.0, 3) AS days_diff,
        download_count - LAG(download_count) OVER w AS download_count_diff
    FROM
        diagrid_dashboard
    WINDOW w AS (ORDER BY collection_date)
    ) sub
ORDER BY
    collection_date;

---


CREATE OR REPLACE VIEW nuget_dapr_client_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM nuget_dapr_client
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM nuget_dapr_client
)
ORDER BY package_name;

---

CREATE OR REPLACE VIEW npm_dapr_dapr_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM npm_dapr_dapr
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM npm_dapr_dapr
)
ORDER BY package_name;

---

CREATE OR REPLACE VIEW python_dapr_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM python_dapr
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM python_dapr
)
ORDER BY package_name;

---

-- One view per PyPI package. pypistats reports downloads over a window rather
-- than a cumulative total, so the weekly rate comes straight from the row and
-- needs no comparison with the previous collection.

CREATE OR REPLACE VIEW python_dapr_view AS

SELECT
    collection_date,
    package_version,
    download_count,
    collected_over_number_of_days,
    CEIL(download_count::numeric / collected_over_number_of_days::numeric * 7::numeric) AS weekly_download_count
FROM
    python_dapr
WHERE
    package_name = 'dapr'
ORDER BY
    collection_date;

---

CREATE OR REPLACE VIEW python_dapr_agents_view AS

SELECT
    collection_date,
    package_version,
    download_count,
    collected_over_number_of_days,
    CEIL(download_count::numeric / collected_over_number_of_days::numeric * 7::numeric) AS weekly_download_count
FROM
    python_dapr
WHERE
    package_name = 'dapr-agents'
ORDER BY
    collection_date;

---

CREATE OR REPLACE VIEW python_dapr_ext_workflow_view AS

SELECT
    collection_date,
    package_version,
    download_count,
    collected_over_number_of_days,
    CEIL(download_count::numeric / collected_over_number_of_days::numeric * 7::numeric) AS weekly_download_count
FROM
    python_dapr
WHERE
    package_name = 'dapr-ext-workflow'
ORDER BY
    collection_date;

---

CREATE OR REPLACE VIEW nuget_dapr_actors_view AS

SELECT
    collection_date,
    package_version,
    days_diff,
    ROUND((download_count - LAG(download_count, 1, 0::bigint) OVER (PARTITION BY package_version ORDER BY collection_date))::numeric / NULLIF(days_diff, 0) * 7) AS download_count_increment
FROM
    (SELECT
        collection_date::date AS collection_date,
        package_version,
        download_count,
        ROUND(EXTRACT(EPOCH FROM collection_date - LAG(collection_date, 1, collection_date - INTERVAL '15 days') OVER (PARTITION BY package_version ORDER BY collection_date)) / 86400.0, 3) AS days_diff
    FROM
        nuget_dapr_client
    WHERE
        package_name = 'Dapr.Actors'
    ) sub
ORDER BY
    collection_date,
    package_version;

---

CREATE TABLE scarf_building_block_views (
    id SERIAL PRIMARY KEY,
    week_start DATE NOT NULL,
    building_block VARCHAR(255) NOT NULL,
    company_name VARCHAR(255) NOT NULL,
    company_domain VARCHAR(255) NOT NULL DEFAULT '',
    views BIGINT NOT NULL,
    unique_visitors BIGINT NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    CONSTRAINT scarf_building_block_views_unique
        UNIQUE (week_start, building_block, company_name, company_domain)
);

CREATE TABLE scarf_company_views (
    id SERIAL PRIMARY KEY,
    week_start DATE NOT NULL,
    company_name VARCHAR(255) NOT NULL,
    company_domain VARCHAR(255) NOT NULL DEFAULT '',
    views BIGINT NOT NULL,
    unique_visitors BIGINT NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    CONSTRAINT scarf_company_views_unique
        UNIQUE (week_start, company_name, company_domain)
);

---

CREATE OR REPLACE VIEW scarf_building_block_company_view AS
SELECT
    week_start,
    company_name,
    company_domain,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'actors'), 0)             AS actors,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'bindings'), 0)           AS bindings,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'configuration'), 0)      AS configuration,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'conversation'), 0)       AS conversation,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'cryptography'), 0)       AS cryptography,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'distributed-lock'), 0)   AS distributed_lock,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'jobs'), 0)               AS jobs,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'pubsub'), 0)             AS pubsub,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'secrets'), 0)            AS secrets,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'service-invocation'), 0) AS service_invocation,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'state-management'), 0)   AS state_management,
    COALESCE(SUM(views) FILTER (WHERE building_block = 'workflow'), 0)           AS workflow,
    COALESCE(SUM(views) FILTER (WHERE building_block = '(index)'), 0)            AS index_page,
    SUM(views)                                                                   AS total
FROM scarf_building_block_views
GROUP BY week_start, company_name, company_domain;

---

CREATE OR REPLACE VIEW scarf_top_companies_view AS
SELECT week_start, company_name, company_domain, views, unique_visitors, rank
FROM (
    SELECT
        week_start,
        company_name,
        company_domain,
        views,
        unique_visitors,
        ROW_NUMBER() OVER (
            PARTITION BY week_start
            ORDER BY views DESC, company_name
        ) AS rank
    FROM scarf_company_views
) ranked
WHERE rank <= 100;

---

CREATE TABLE scarf_diagrid_page_views (
    id SERIAL PRIMARY KEY,
    week_start DATE NOT NULL,
    site VARCHAR(255) NOT NULL,
    page_path VARCHAR(512) NOT NULL,
    company_name VARCHAR(255) NOT NULL,
    company_domain VARCHAR(255) NOT NULL DEFAULT '',
    views BIGINT NOT NULL,
    unique_visitors BIGINT NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    CONSTRAINT scarf_diagrid_page_views_unique
        UNIQUE (week_start, site, page_path, company_name, company_domain)
);

-- The unique constraint's own index leads with week_start but puts site and
-- page_path ahead of the company columns, so it does not serve the view's
-- GROUP BY. This table reaches ~1M rows within a year, so the view needs its
-- own index.
CREATE INDEX scarf_diagrid_page_views_week_company
    ON scarf_diagrid_page_views (week_start, company_name, company_domain);

---

-- total_views is the headline number: how many pages a company viewed that
-- week across both sites.
--
-- unique_visitors is deliberately absent. It is stored per page and summing
-- distinct counts across pages is never correct — one person reading five
-- pages would count five times.
CREATE OR REPLACE VIEW scarf_diagrid_company_pages_view AS
SELECT
    week_start,
    company_name,
    company_domain,
    SUM(views)                                                      AS total_views,
    COALESCE(SUM(views) FILTER (WHERE site = 'diagrid.io'), 0)      AS website_views,
    COALESCE(SUM(views) FILTER (WHERE site = 'docs.diagrid.io'), 0) AS docs_views
FROM scarf_diagrid_page_views
GROUP BY week_start, company_name, company_domain;