-- No collected_over_number_of_days here, unlike npm_dapr_dapr and python_dapr:
-- NuGet reports a cumulative total per version rather than downloads over a
-- window, so GetNuGetPackageData inserts four columns and the views derive the
-- rate from the gap between collection_date values instead.
CREATE TABLE nuget_dapr_client (
    id SERIAL PRIMARY KEY,
    package_name VARCHAR(255) NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    package_version VARCHAR(50) NOT NULL,
    download_count BIGINT NOT NULL
);

CREATE TABLE npm_dapr_dapr (
    id SERIAL PRIMARY KEY,
    package_name VARCHAR(255) NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    package_version VARCHAR(50) NOT NULL,
    download_count BIGINT NOT NULL,
    collected_over_number_of_days SMALLINT
);

CREATE TABLE python_dapr (
    id SERIAL PRIMARY KEY,
    package_name VARCHAR(255) NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    package_version VARCHAR(50) NOT NULL,
    download_count BIGINT NOT NULL,
    collected_over_number_of_days SMALLINT
);

CREATE TABLE java_dapr_sdk (
    id SERIAL PRIMARY KEY,
    package_name VARCHAR(255) NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    package_version VARCHAR(50) NOT NULL,
    download_count BIGINT NOT NULL,
    percentage NUMERIC(5,4),
    collected_over_number_of_days SMALLINT
);


CREATE TABLE discord_dapr (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    member_count INT NOT NULL
);

CREATE TABLE discord_visitors (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    weekly_visitors INT NOT NULL,
    monthly_visitors INT NOT NULL
);

CREATE TABLE dockerhub_images (
    id SERIAL PRIMARY KEY,
    namespace VARCHAR(255) NOT NULL,
    image_name VARCHAR(255) NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    pull_count BIGINT NOT NULL
);

CREATE TABLE diagrid_dashboard (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    download_count BIGINT NOT NULL
);

CREATE TABLE github_dapr (
    id SERIAL PRIMARY KEY,
    repo_name VARCHAR(255) NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    fork_count_total INT NOT NULL,
    star_count_total INT NOT NULL,
    commit_count INT NOT NULL,
    commit_users TEXT,
    issue_count INT NOT NULL,
    issue_users TEXT,
    comment_count INT NOT NULL, 
    comment_users TEXT,
    pullrequest_count INT NOT NULL,
    pullrequest_users TEXT,
    distinct_user_count INT NOT NULL,
    collected_over_number_of_days SMALLINT
);

CREATE TABLE website_dapr (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    user_count BIGINT NOT NULL
);

CREATE TABLE website_dapr_monthly (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    user_count BIGINT NOT NULL,
    collected_over_number_of_days SMALLINT
);

CREATE TABLE youtube_dapr (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    view_count BIGINT NOT NULL
);

CREATE TABLE youtube_dapr_monthly (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    view_count BIGINT NOT NULL,
    collected_over_number_of_days SMALLINT
);

-- One-off table of 2024 growth projections, filled in by hand rather than by a
-- collector. Kept for the historical comparison in the Grafana dashboard.
CREATE TABLE projections_2024 (
    id SERIAL PRIMARY KEY,
    collection_date TIMESTAMP NOT NULL,
    day INT NOT NULL,
    discord_member_count INT NOT NULL,
    github_stars INT NOT NULL,
    github_contributors INT NOT NULL,
    github_committers INT NOT NULL,
    net_sdk_weekly INT NOT NULL,
    js_sdk_weekly INT NOT NULL,
    python_sdk_weekly INT NOT NULL,
    java_sdk_weekly INT NOT NULL,
    website_views INT NOT NULL,
    youtube_views INT NOT NULL
);

CREATE TABLE datadog_rum (
    id SERIAL PRIMARY KEY,
    service VARCHAR(255) NOT NULL,
    week_start DATE NOT NULL,
    session_count BIGINT NOT NULL,
    unique_user_count BIGINT NOT NULL,
    collection_date TIMESTAMP NOT NULL,
    CONSTRAINT datadog_rum_service_week_unique UNIQUE (service, week_start)
);

CREATE TABLE datadog_rum_users (
    id SERIAL PRIMARY KEY,
    service VARCHAR(255) NOT NULL,
    user_anonymous_id VARCHAR(64) NOT NULL,
    install_date DATE,
    collection_date TIMESTAMP NOT NULL,
    CONSTRAINT datadog_rum_users_service_user_unique UNIQUE (service, user_anonymous_id)
);

-- unique_user_count and org_count are NOT additive: summing either across
-- weeks double-counts anyone active in more than one week. For cumulative
-- figures use datadog_rum_identified_users_view.total_users / total_orgs.
--
-- Both are DataDog `cardinality` aggregations, which are ESTIMATES. They are
-- exact at current volume (tens of users per week); a small divergence from a
-- registry-derived count at higher volume is an approximation artifact, not a
-- defect.
--
-- org_count and the view's total_orgs count different populations and may
-- disagree in either direction. org_count is every distinct
-- @usr.organization seen in that week's sessions. total_orgs counts
-- organisations recorded in datadog_rum_identified_user_orgs, which no longer
-- collapses a multi-organisation user -- so the remaining reasons the two
-- disagree are that org_count also counts organisations whose sessions carried
-- an id the registry has not reached yet, and that org_count is a cardinality
-- estimate. A week where org_count exceeds total_orgs is expected, not a bug.
-- unique_user_count comes from DataDog's `cardinality` aggregation, which is
-- an estimate: exact at current volume (~29 users/week), but a small
-- divergence from datadog_rum_identified_users_view's registry-based count is
-- expected at higher volume, not a defect.
CREATE TABLE datadog_rum_identified (
    id SERIAL PRIMARY KEY,
    service VARCHAR(255) NOT NULL,
    env VARCHAR(255) NOT NULL,
    week_start DATE NOT NULL,
    session_count BIGINT NOT NULL,
    unique_user_count BIGINT NOT NULL,
    org_count BIGINT,
    collection_date TIMESTAMP NOT NULL,
    CONSTRAINT datadog_rum_identified_week_unique
        UNIQUE (service, env, week_start)
);

-- Holds real customer email addresses and names: PII, along with
-- datadog_rum_identified_user_orgs. Never print or log these values -- this
-- repository is public and its GitHub Actions run logs are world-readable.
-- Report from datadog_rum_identified_users_view, which exposes counts.
--
-- user_organization holds ONE of possibly several organisations this user has
-- been seen under. Across weeks the newest non-null value wins, but WITHIN a
-- week it is DataDog's first bucket -- the organisation with the most sessions,
-- not the latest one -- so for a multi-organisation account the stored label is
-- "the busiest organisation in the newest week that had any". It exists for
-- labelling a single user, and counting over it UNDERCOUNTS: it returned 17
-- distinct values where DataDog had 24. Use datadog_rum_identified_user_orgs
-- to count organisations, or to answer "which organisations does this user
-- belong to".
--
-- A NULL install_date means the user was first observed in the OLDEST week the
-- run collected, so the account existed at or before the edge of the
-- three-week lookback and its true first week is outside RUM's 30-day
-- retention. It is unknowable, not uncaptured -- there is no "not captured"
-- case, because a user with no observed week is never written at all. This is
-- why all three dapr-ops-dashboard.diagrid.io rows are null: that host's
-- traffic begins inside the lookback, so every one of its users was first seen
-- in the boundary week. datadog_rum_identified_user_orgs.first_seen_week means
-- the same thing for pairs.
--
-- datadog_rum_identified_users_view resolves these nulls to MIN(week_start) of
-- datadog_rum_identified, which is a FLOOR, not a measurement: the more
-- history that table holds, the further from the truth the floor sits. Anyone
-- backfilling earlier weeks into datadog_rum_identified moves every
-- null-install_date user and null-first_seen_week organisation to the new
-- earliest week in the view's new_users / new_orgs columns.
CREATE TABLE datadog_rum_identified_users (
    id SERIAL PRIMARY KEY,
    service VARCHAR(255) NOT NULL,
    env VARCHAR(255) NOT NULL,
    user_id VARCHAR(128) NOT NULL,
    user_email VARCHAR(320),
    user_name VARCHAR(255),
    user_organization VARCHAR(128),
    install_date DATE,
    collection_date TIMESTAMP NOT NULL,
    CONSTRAINT datadog_rum_identified_users_unique
        UNIQUE (service, env, user_id)
);

-- One row per (user, organisation) pair ever observed. @usr.organization is a
-- per-SESSION attribute and a Conductor user can belong to several
-- organisations, so this relationship is many-to-many: as of 2026-09-02 one
-- account has been seen under 8 organisations and four more under 2. Count
-- organisations HERE, never with count(distinct user_organization) on
-- datadog_rum_identified_users -- that column keeps only one of them and
-- undercounted 17 against a true 24 when this table was added.
--
-- Holds a user id joined to an organisation identifier: PII, like
-- datadog_rum_identified_users. Never print or log these values -- this
-- repository is public and its GitHub Actions run logs are world-readable.
-- Report from datadog_rum_identified_users_view, which exposes counts.
--
-- first_seen_week is the Monday of the ISO week the PAIR was first observed
-- in, or NULL when that was the oldest week the run collected -- meaning the
-- pair existed at or before the edge of what was queried and its true first
-- week is unknowable. Same convention as install_date.
--
-- env is part of the key, so a pair active on both deployment hosts is stored
-- twice: count(*) is a row count, NOT a pair count. count(distinct
-- organization) is safe across envs; counting pairs needs
-- count(distinct (user_id, organization)).
CREATE TABLE datadog_rum_identified_user_orgs (
    id SERIAL PRIMARY KEY,
    service VARCHAR(255) NOT NULL,
    env VARCHAR(255) NOT NULL,
    user_id VARCHAR(128) NOT NULL,
    organization VARCHAR(128) NOT NULL,
    first_seen_week DATE,
    collection_date TIMESTAMP NOT NULL,
    CONSTRAINT datadog_rum_identified_user_orgs_unique
        UNIQUE (service, env, user_id, organization)
);

---

CREATE OR REPLACE VIEW datadog_rum_identified_users_view AS
WITH first_week AS (
    SELECT service, env, MIN(week_start) AS week_start
    FROM datadog_rum_identified
    GROUP BY service, env
),
seeded AS (
    SELECT u.service,
           u.env,
           COALESCE(u.install_date, f.week_start) AS week_start,
           u.user_email,
           u.user_organization
    FROM datadog_rum_identified_users u
    JOIN first_week f
      ON f.service = u.service AND f.env = u.env
),
-- An organisation is new in the week its FIRST user appeared, not in every
-- week another of its users shows up. Counting distinct orgs per week would
-- count the same org again each time it gained a user.
--
-- Derived from datadog_rum_identified_user_orgs, not from
-- datadog_rum_identified_users.user_organization: that column keeps only one
-- of a user's organisations, which undercounted total_orgs 17 against a true
-- 24. The COALESCE seeds an unknown first week from the earliest week on
-- record, exactly as `seeded` does for install_date, so both halves of this
-- view treat unknown history the same way.
--
-- CAVEAT -- new_orgs/total_orgs are NOT stable across runs. The COALESCE runs
-- BEFORE the MIN, and f.week_start is the earliest week ever collected for that
-- (service, env), which never advances; first_seen_week is NULL for any pair
-- first seen in the CURRENT run's boundary week, which advances every Monday.
-- So an organisation first observed months from now, in that run's boundary
-- week, is reported as new in the earliest collected week instead -- and an
-- organisation with one known week plus a later NULL pair is dragged back to
-- that floor. `seeded` has the identical flaw for new_users today, so this
-- mirrors existing behaviour rather than adding a new defect. The fix is
-- COALESCE(MIN(o.first_seen_week), MIN(f.week_start)), which keeps an
-- organisation on its earliest KNOWN week; it is deliberately out of scope
-- here and belongs with the install_date rework.
org_first_week AS (
    SELECT o.service,
           o.env,
           o.organization,
           MIN(COALESCE(o.first_seen_week, f.week_start)) AS week_start
    FROM datadog_rum_identified_user_orgs o
    JOIN first_week f
      ON f.service = o.service AND f.env = o.env
    GROUP BY o.service, o.env, o.organization
),
-- The row spine. Every COLLECTED week appears, not just the weeks in which
-- some user was first seen -- otherwise a week with real sessions but no new
-- users produces no row at all, and its session_count has nowhere to land.
-- dapr-ops-dashboard had exactly that: three collected weeks, one view row.
-- Keying on collected weeks alone would be simpler, but a user whose
-- install_date week somehow had no aggregate row (an aggregate write failing
-- while the registry write succeeded) would then vanish from the view and
-- undercount total_users. The union cannot lose a user; session_count simply
-- comes back NULL for such a week.
week_spine AS (
    SELECT service, env, week_start FROM datadog_rum_identified
    UNION
    SELECT service, env, week_start FROM seeded
    UNION
    -- Third arm for the same reason as the second: the spine must not be able
    -- to lose a row. A user can gain an organisation in a week they were not
    -- themselves first seen in, and if that week had no aggregate row the LEFT
    -- JOIN below would drop the organisation and undercount total_orgs.
    SELECT service, env, week_start FROM org_first_week
),
user_weeks AS (
    SELECT service,
           env,
           week_start,
           COUNT(*) AS new_users,
           COUNT(*) FILTER (
               WHERE user_email IS NULL OR user_email NOT ILIKE '%@diagrid.io'
           ) AS new_external_users
    FROM seeded
    GROUP BY service, env, week_start
),
org_weeks AS (
    SELECT service, env, week_start, COUNT(*) AS new_orgs
    FROM org_first_week
    GROUP BY service, env, week_start
)
-- Column ORDER matters here: CREATE OR REPLACE VIEW can only append columns,
-- never insert or rename one, so anything added must go at the end however
-- much better it would read elsewhere. Reordering this list makes the next
-- deployment fail with 42P16.
--
-- Mind the provenance mix in these columns. new_*/total_* are derived from the
-- registry and are exact counts of registered users and organisations, with
-- the external variants excluding @diagrid.io. session_count,
-- unique_user_count and org_count are copied from datadog_rum_identified and
-- come from DataDog `cardinality` aggregations over ALL authenticated
-- accounts, internal included, with no external variant available. Charting
-- unique_user_count against total_external_users compares two different
-- populations measured two different ways.
SELECT s.service,
       s.env,
       s.week_start,
       COALESCE(u.new_users, 0) AS new_users,
       COALESCE(u.new_external_users, 0) AS new_external_users,
       SUM(COALESCE(u.new_users, 0)) OVER w AS total_users,
       SUM(COALESCE(u.new_external_users, 0)) OVER w AS total_external_users,
       COALESCE(o.new_orgs, 0) AS new_orgs,
       SUM(COALESCE(o.new_orgs, 0)) OVER w AS total_orgs,
       a.session_count,
       a.unique_user_count,
       a.org_count
FROM week_spine s
LEFT JOIN user_weeks u
  ON u.service = s.service AND u.env = s.env AND u.week_start = s.week_start
LEFT JOIN org_weeks o
  ON o.service = s.service AND o.env = s.env AND o.week_start = s.week_start
LEFT JOIN datadog_rum_identified a
  ON a.service = s.service AND a.env = s.env AND a.week_start = s.week_start
WINDOW w AS (PARTITION BY s.service, s.env ORDER BY s.week_start);

---

CREATE OR REPLACE VIEW nuget_dapr_client_view AS

SELECT
    collection_date,
    package_version,
    days_diff,
    ROUND((download_count - LAG(download_count, 1, 0::bigint) OVER (PARTITION BY package_version ORDER BY collection_date))::numeric / NULLIF(days_diff, 0) * 7) AS download_count_increment
FROM
    (SELECT
        collection_date::date AS collection_date,
        package_version,
        download_count,
        ROUND(EXTRACT(EPOCH FROM collection_date - LAG(collection_date, 1, collection_date - INTERVAL '15 days') OVER (PARTITION BY package_version ORDER BY collection_date)) / 86400.0, 3) AS days_diff
    FROM
        nuget_dapr_client
    WHERE
        package_name = 'Dapr.Client'
    ) sub
ORDER BY
    collection_date,
    package_version;

---

