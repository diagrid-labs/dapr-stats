---

CREATE VIEW java_dapr_sdk_view AS

SELECT 
    collection_date::date,
    package_version,
    ROUND(download_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_downloads
FROM 
    java_dapr_sdk
ORDER BY 
    collection_date,
    package_version

---

CREATE VIEW weekly_github_counts_dapr AS
SELECT 
    repo_name,
    collection_date,
    ROUND(issue_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_issue_count,
    ROUND(comment_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_comment_count,
    ROUND(commit_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_commit_count,
    ROUND(pullrequest_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_pullrequest_count,
    ROUND(distinct_user_count::DECIMAL / collected_over_number_of_days * 7) AS avg_weekly_distinct_user_count
FROM 
    github_dapr

---

CREATE OR REPLACE VIEW dockerhub_images_view AS

SELECT
    namespace,
    image_name,
    collection_date,
    days_diff,
    pull_count_diff,
    ROUND(pull_count_diff::numeric / NULLIF(days_diff, 0) * 7) AS avg_weekly_diff
FROM
    (SELECT
        namespace,
        image_name,
        collection_date,
        ROUND(EXTRACT(EPOCH FROM collection_date - LAG(collection_date) OVER w) / 86400.0, 3) AS days_diff,
        pull_count - LAG(pull_count) OVER w AS pull_count_diff
    FROM
        dockerhub_images
    WINDOW w AS (PARTITION BY namespace, image_name ORDER BY collection_date)
    ) sub
ORDER BY
    collection_date;

---

CREATE OR REPLACE VIEW diagrid_dashboard_view AS

SELECT
    collection_date,
    days_diff,
    download_count_diff,
    ROUND(download_count_diff::numeric / NULLIF(days_diff, 0) * 7) AS avg_weekly_diff
FROM
    (SELECT
        collection_date,
        ROUND(EXTRACT(EPOCH FROM collection_date - LAG(collection_date) OVER w) / 86400.0, 3) AS days_diff,
        download_count - LAG(download_count) OVER w AS download_count_diff
    FROM
        diagrid_dashboard
    WINDOW w AS (ORDER BY collection_date)
    ) sub
ORDER BY
    collection_date;

---


CREATE OR REPLACE VIEW nuget_dapr_client_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM nuget_dapr_client
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM nuget_dapr_client
)
ORDER BY package_name;

---

CREATE OR REPLACE VIEW npm_dapr_dapr_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM npm_dapr_dapr
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM npm_dapr_dapr
)
ORDER BY package_name;

---

CREATE OR REPLACE VIEW python_dapr_latest_packages_view AS
SELECT DISTINCT package_name, collection_date::date
FROM python_dapr
WHERE collection_date::date = (
    SELECT MAX(collection_date::date) FROM python_dapr
)
ORDER BY package_name;

---

