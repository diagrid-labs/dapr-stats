-- 3. Verify. Every table should report exactly ONE distinct run hour for the
--    day, and the surviving rows should be the 14:5x scheduled run.
--
--    Expected after the delete:
--
--      table               rows_kept  first_row  last_row   total
--      nuget_dapr_client       248     14:54:44  14:55:59   71,618,864 downloads
--      github_dapr              45     14:56:45  14:56:47   33,864 stars
--      npm_dapr_dapr            15     14:54:44  14:54:47   57,142 downloads
--      dockerhub_images          6     14:56:05  14:56:05   94,803,522 pulls
--      discord_dapr              1     14:56:07  14:56:07   8,066 members
--      diagrid_dashboard         1     14:56:08  14:56:08   24,618 downloads
--      python_dapr               4     13:12:23  14:54:44   UNCHANGED, 4 packages
--
--    33,864 stars sits just above the 33,836 recorded on 2026-09-01, which is
--    the sanity check that the double-count (67,728) is gone. For python_dapr
--    the third column is the distinct package count, not the run-hour count,
--    and 4 is the value to expect.

SELECT 'nuget_dapr_client' AS table_name, count(*) AS rows_kept,
       count(DISTINCT date_trunc('hour', collection_date)) AS distinct_run_hours,
       min(collection_date) AS first_row, max(collection_date) AS last_row,
       sum(download_count) AS total
FROM nuget_dapr_client
WHERE collection_date >= DATE '2026-09-07' AND collection_date < DATE '2026-09-08'
UNION ALL
SELECT 'github_dapr', count(*), count(DISTINCT date_trunc('hour', collection_date)),
       min(collection_date), max(collection_date), sum(star_count_total)
FROM github_dapr
WHERE collection_date >= DATE '2026-09-07' AND collection_date < DATE '2026-09-08'
UNION ALL
SELECT 'npm_dapr_dapr', count(*), count(DISTINCT date_trunc('hour', collection_date)),
       min(collection_date), max(collection_date), sum(download_count)
FROM npm_dapr_dapr
WHERE collection_date >= DATE '2026-09-07' AND collection_date < DATE '2026-09-08'
UNION ALL
SELECT 'dockerhub_images', count(*), count(DISTINCT date_trunc('hour', collection_date)),
       min(collection_date), max(collection_date), sum(pull_count)
FROM dockerhub_images
WHERE collection_date >= DATE '2026-09-07' AND collection_date < DATE '2026-09-08'
UNION ALL
SELECT 'discord_dapr', count(*), count(DISTINCT date_trunc('hour', collection_date)),
       min(collection_date), max(collection_date), sum(member_count)
FROM discord_dapr
WHERE collection_date >= DATE '2026-09-07' AND collection_date < DATE '2026-09-08'
UNION ALL
SELECT 'diagrid_dashboard', count(*), count(DISTINCT date_trunc('hour', collection_date)),
       min(collection_date), max(collection_date), sum(download_count)
FROM diagrid_dashboard
WHERE collection_date >= DATE '2026-09-07' AND collection_date < DATE '2026-09-08'
UNION ALL
SELECT 'python_dapr (untouched)', count(*), count(DISTINCT package_name),
       min(collection_date), max(collection_date), sum(download_count)
FROM python_dapr
WHERE collection_date >= DATE '2026-09-07' AND collection_date < DATE '2026-09-08'
ORDER BY table_name;


