--   WHERE collection_date >= TIMESTAMP '2026-09-07 13:00:00'
--     AND collection_date <  TIMESTAMP '2026-09-07 14:00:00'
--   RETURNING 1
-- ), d_github AS (
--   DELETE FROM github_dapr
--   WHERE collection_date >= TIMESTAMP '2026-09-07 13:00:00'
--     AND collection_date <  TIMESTAMP '2026-09-07 14:00:00'
--   RETURNING 1
-- ), d_npm AS (
--   DELETE FROM npm_dapr_dapr
--   WHERE collection_date >= TIMESTAMP '2026-09-07 13:00:00'
--     AND collection_date <  TIMESTAMP '2026-09-07 14:00:00'
--   RETURNING 1
-- ), d_docker AS (
--   DELETE FROM dockerhub_images
--   WHERE collection_date >= TIMESTAMP '2026-09-07 13:00:00'
--     AND collection_date <  TIMESTAMP '2026-09-07 14:00:00'
--   RETURNING 1
-- ), d_discord AS (
--   DELETE FROM discord_dapr
--   WHERE collection_date >= TIMESTAMP '2026-09-07 13:00:00'
--     AND collection_date <  TIMESTAMP '2026-09-07 14:00:00'
--   RETURNING 1
-- ), d_dashboard AS (
--   DELETE FROM diagrid_dashboard
--   WHERE collection_date >= TIMESTAMP '2026-09-07 13:00:00'
--     AND collection_date <  TIMESTAMP '2026-09-07 14:00:00'
--   RETURNING 1
-- )
