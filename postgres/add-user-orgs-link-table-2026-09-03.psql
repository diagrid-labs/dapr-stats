--    grows past 24 as runs accumulate.
-- select count(distinct organization) from datadog_rum_identified_user_orgs
-- where service = 'conductor-ui';

-- 3. Nothing regressed. Expect 6 and 12.
-- select (select count(*) from datadog_rum_identified) as agg_rows,
--        (select count(*) from information_schema.columns
--         where table_name = 'datadog_rum_identified_users_view') as view_cols;

-- 4. The view. total_orgs must RISE (to 23 on conductor.r1, 3 on
--    dapr-ops-dashboard); new_users/total_users must NOT move (54 / 3).
--    No single view row will ever read 24 -- total_orgs is windowed per
--    (service, env), so the cross-host figure exists only as query 2. Summing
--    the two hosts gives 26 and double-counts.
-- select service, env, week_start, new_orgs, total_orgs, new_users, total_users
-- from datadog_rum_identified_users_view
-- where service = 'conductor-ui' order by env, week_start;

-- KNOWN, DEFERRED: new_orgs/total_orgs week attribution is not stable across
-- runs. org_first_week does MIN(COALESCE(first_seen_week, floor)), and the
-- COALESCE runs before the MIN, so an organisation first seen in a future run's
-- boundary week is reported as new in the earliest collected week instead. The
-- `seeded` CTE has the same floor-seeding instability for new_users today, so
-- this is pre-existing rather than new. Remedy, when someone picks it up:
-- COALESCE(MIN(o.first_seen_week), MIN(f.week_start)). It belongs with the
-- install_date rework, which was deliberately out of scope here.
