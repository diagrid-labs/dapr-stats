-- Fix: partial-day truncation inflated the weekly download/pull increments.
--
-- The views divided the download delta by EXTRACT(DAY FROM <interval>), which
-- truncates towards zero: a real gap of 14 days 23:52 became a divisor of 14,
-- and a gap of 4 days 20:00 became 4. Because the divisor could only ever be
-- too small, the *_increment / avg_weekly_diff columns could only ever be too
-- high -- on average +4.7%, worst observed case +20.8% (Dapr.Client, 1672 rows).
--
-- The fix uses the exact elapsed time instead:
--     EXTRACT(EPOCH FROM (collection_date - lag(collection_date))) / 86400
-- rounded to 3 decimals (86.4 s) so the value reported in days_diff is the same
-- value used as the divisor.
--
-- Notes:
--   * days_diff stays NUMERIC so CREATE OR REPLACE VIEW can reuse the existing
--     column (a date - date INTEGER would fail with SQLSTATE 42P16).
--   * NULLIF(days_diff, 0) guards against two collections sharing a timestamp,
--     which would otherwise fail the whole view with a division by zero.
--   * The 15-day LAG default on the NuGet views is preserved: the first row of
--     each package_version still reports total downloads / 15 * 7, which is a
--     baseline artefact rather than a real weekly increment.
--   * python_dapr_view and the *_latest_packages_view family are unaffected --
--     PyPI reports its own collected_over_number_of_days.

-- --------------------------------------------------------------------------
-- NuGet package views (8) -- identical apart from the package_name filter
-- --------------------------------------------------------------------------

CREATE OR REPLACE VIEW nuget_dapr_client_view AS

SELECT
    collection_date,
    package_version,
    days_diff,
    ROUND((download_count - LAG(download_count, 1, 0::bigint) OVER (PARTITION BY package_version ORDER BY collection_date))::numeric / NULLIF(days_diff, 0) * 7) AS download_count_increment
FROM
    (SELECT
        collection_date::date AS collection_date,
        package_version,
        download_count,
        ROUND(EXTRACT(EPOCH FROM collection_date - LAG(collection_date, 1, collection_date - INTERVAL '15 days') OVER (PARTITION BY package_version ORDER BY collection_date)) / 86400.0, 3) AS days_diff
    FROM
        nuget_dapr_client
    WHERE
        package_name = 'Dapr.Client'
    ) sub
ORDER BY
    collection_date,
    package_version;

